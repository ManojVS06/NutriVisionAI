# =============================================
# NutriVision AI — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# --- Application ---
APP_NAME=NutriVision AI
APP_ENV=development         # development | production
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
API_VERSION=v1

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutrivision
POSTGRES_USER=nutrivision_user
POSTGRES_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://nutrivision_user:your-db-password-here@localhost:5432/nutrivision

# --- Redis (caching) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- ML Models ---
# Path to trained model weights (download from HuggingFace Hub)
YOLO_MODEL_PATH=weights/nutrivision_yolov11.pt
CONVNEXT_MODEL_PATH=weights/nutrivision_convnext.pt
SAM2_MODEL_PATH=weights/sam2_hiera_large.pt
DEPTH_MODEL_PATH=weights/depth_anything_v2_vitl.pth

# Confidence thresholds
YOLO_CONFIDENCE_THRESHOLD=0.5
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# --- LLM (AI Coach) ---
# Option 1: Use Ollama (local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma2:9b

# Option 2: Use HuggingFace API
# LLM_PROVIDER=huggingface
# HF_API_TOKEN=hf_your_token_here
# HF_MODEL_ID=google/gemma-7b-it

# Option 3: Use OpenAI-compatible API
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=backend/uploads

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=NutriVision AI
